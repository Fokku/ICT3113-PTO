# ---------------------------------------------------------------------------
# ICT3113 Assignment 1 — service configuration (Team 10)
# Owner: Yeo Kai Yuan (Part 1 — baseline service)
#
# Copy to .env and edit. .env is gitignored; this example file is committed, so
# it is the documented record of every knob the service has.
#
#   cp .env.example .env
#
# Precedence: a real environment variable beats .env, which beats the defaults
# compiled into service/config.py. Every value below IS the default, so an
# unedited copy of this file changes nothing — that is deliberate, so a diff
# against it shows exactly what a run was configured with.
#
# All of these are reported by GET /health and written to the start-up log line,
# and the ones that can change a measurement (model tag and digest, NUM_CTX,
# seed, prompt hash) are also written into every run's metadata.json.
# ---------------------------------------------------------------------------

# --- Model backend ---------------------------------------------------------

# Where Ollama is. Inside docker compose the service name resolves on the compose
# network. Use http://localhost:11434 when running the service outside Docker, or
# http://<host>:11434 to point at Ollama on another machine (see the comments at
# the top of docker-compose.yml — the `local-ollama` profile exists for this).
OLLAMA_BASE_URL=http://ollama:11434

# The Ollama tag actually served. One model per service run: switching candidates
# means restarting with a different tag, so that a run's logs describe one model.
MODEL_TAG=llama3.2:1b

# Optional digest pin, recorded from models/models.yaml, logged verbatim. Leave
# empty and the service asks Ollama's /api/tags at start-up which digest it is
# serving for MODEL_TAG, and logs what it found. An explicit value here is never
# overwritten by that probe, so a mismatch shows up instead of being papered over.
MODEL_DIGEST=

# Context window, in tokens, sent with every request as options.num_ctx, and
# logged on every request.
#
# WHY THIS IS SET EXPLICITLY: Ollama's own default is 2048 tokens, and it does not
# warn when a prompt exceeds it — the beginning of the prompt is silently dropped.
# Our team's rows run to 1,999 characters (mean 861), which is roughly 500 tokens,
# and the classification prompt adds its instructions and the seven category names
# on top. A truncated prompt would still return a category, so the failure would
# show up as unexplained model error in the accuracy results rather than as an
# error, and we would have no way to find it after the fact. 4096 leaves ample
# headroom for the longest ticket in the dataset.
NUM_CTX=4096

# HTTP timeout, in seconds, for one model call. Generous on purpose: on CPU a
# larger candidate model can take a long time for one ticket, and a timeout we set
# too tight would turn a slow-but-working configuration into an error rate, which
# is a different finding. Timeouts are reported as "ollama_timeout" in the log.
OLLAMA_TIMEOUT_S=120

# Sampling seed. Fixed, and temperature is fixed at 0 in code, so re-running the
# accuracy test on the same model and prompt gives the same answers.
OLLAMA_SEED=42

# --- Storage and evidence --------------------------------------------------

# SQLite file. Must stay under /data, which is where docker-compose.yml mounts the
# named volume that scripts/reset.sh deletes between runs.
DB_PATH=/data/triage.db

# Where the JSONL request log is written, one file per UTC date. Bind-mounted to
# ./logs/service on the host, because these files are the evidence every reported
# number has to reconcile with.
LOG_DIR=/logs/service

# --- Web tier --------------------------------------------------------------

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ONE uvicorn worker. Explicit because the process model is part of the baseline
# we report: one worker, one event loop, one writer to SQLite and to the log.
# Changing it changes what is being measured.
UVICORN_WORKERS=1

# Size of the anyio worker-thread pool that blocking SQLite calls are handed to.
# 40 is the framework default; it is set explicitly so the value is visible in
# /health and in the start-up log rather than being an invisible library default.
SERVICE_THREADPOOL_SIZE=40

# Python log level for the service's own stdout logging (not the JSONL request
# log, whose schema is fixed). DEBUG is noisy under load.
LOG_LEVEL=INFO

# --- Ollama container settings (only used with the local-ollama profile) ----

# Both are set to Ollama's own default sentinel 0, meaning "let Ollama decide".
# They are stated explicitly so the value lands in `docker compose config` and in
# every run's metadata.json. We are deliberately NOT tuning them: Ollama's
# concurrency is where we expect the bottleneck, and tuning it is Assignment 2.
OLLAMA_NUM_PARALLEL=0
OLLAMA_MAX_LOADED_MODELS=0

# Host port the Ollama container publishes.
OLLAMA_PORT=11434
